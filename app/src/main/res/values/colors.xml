<resources>
    <!-- Palette Mnemosyne, piste « 1a — Encre & Patine ».
         Ces valeurs ne servent qu'aux ressources Android (splash, barre système,
         icône, widget de chargement) : le rendu de l'app est piloté par Compose
         (ui/theme/Color.kt, qui porte les mêmes valeurs). -->
    <color name="encre">#0B1620</color>
    <color name="pierre">#E4E7E2</color>
    <color name="patine">#3E7A6C</color>
    <color name="bronze">#C99A5B</color>
    <color name="filet">#24394A</color>

    <!-- Fond de l'application en thème clair (pierre légèrement grisée). -->
    <color name="fond">#E9ECE8</color>

    <!-- Fond de l'adaptive icon : Encre, comme png/maskable-512.png. -->
    <color name="ic_launcher_background">@color/encre</color>
</resources>
