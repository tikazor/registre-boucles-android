<?xml version="1.0" encoding="utf-8"?>
<!--
  Marque Mnemosyne pour l'usage DANS l'interface (barre de titre, écran
  d'accueil), à ~24-32 dp. Source : mnemosyne-icones/mnemosyne-48.svg —
  palier « 48-64 px », trait épaissi à 2,0 : à cette taille les quatre tours de
  spirale se rempliraient avec le trait 1,2.

  Les couleurs déclarées ici sont neutres : en Compose, `Icon(...)` applique
  son propre `tint`, ce qui permet à la marque de suivre la couleur du texte
  parent (l'équivalent du `currentColor` du SVG d'origine).

  Pour l'icône de lancement, voir ic_launcher_foreground.xml (trait 1,2).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="64"
    android:viewportHeight="64">

    <!-- La goutte : aplat sans contour. -->
    <path
        android:fillColor="#E4E7E2"
        android:pathData="M32,19.15c0,0,6.25,7.08,6.25,10.83a6.25,6.25,0,1,1,-12.5,0c0,-3.75,6.25,-10.83,6.25,-10.83z" />

    <!-- Spirale 1. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#E4E7E2"
        android:strokeWidth="2.0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M27,37.25a7,2.8,0,0,1,14,0a11,4.4,0,0,1,-22,0a15,6,0,0,1,30,0a19,7.6,0,0,1,-38,0" />

    <!-- Spirale 2 : sens contraire. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#E4E7E2"
        android:strokeWidth="2.0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M37,37.25a7,2.8,0,0,0,-14,0a11,4.4,0,0,0,22,0a15,6,0,0,0,-30,0a19,7.6,0,0,0,38,0" />
</vector>
